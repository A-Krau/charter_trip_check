# Copy to .env and fill in. Never commit .env.

# OpenSky API client (https://opensky-network.org > Account > API client).
# Leave blank to run anonymously with much lower daily limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Port on the host where the web page is served.
HOST_PORT=8080

# Optional: OpenSky aircraft database CSV placed in ./data, for better
# registration/type/operator coverage, e.g. /data/aircraftDatabase.csv
AIRCRAFT_DB_PATH=

# Largest search window in days.
MAX_WINDOW_DAYS=7
